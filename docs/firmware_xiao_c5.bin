<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>CyberChuck // Hacking 101</title>
<style>
:root{
  --bg:#05080d; --panel:#0a121d; --edge:#123047; --edge2:#0e2233;
  --cyan:#38d6ff; --cyanDim:#1c7ea0; --ink:#d3e3f0; --dim:#647a8c;
  --ok:#3ff0a0; --warn:#ffb454; --bad:#ff6472;
  --mono:ui-monospace,"Cascadia Code","JetBrains Mono",Consolas,"Courier New",monospace;
}
*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0;background:
    radial-gradient(120% 60% at 50% -10%, #0b1b2a 0%, transparent 60%), var(--bg);
  color:var(--ink);font-family:var(--mono);
  padding-top:env(safe-area-inset-top,0);padding-bottom:env(safe-area-inset-bottom,0);
  -webkit-text-size-adjust:100%;
}
.wrap{max-width:640px;margin:0 auto;min-height:100%;display:flex;flex-direction:column}
header{
  display:flex;align-items:center;justify-content:space-between;
  padding:12px 14px;border-bottom:1px solid var(--edge);
  background:linear-gradient(#0a1622,#070f18);position:sticky;top:0;z-index:5;
}
.brand{font-weight:800;letter-spacing:.5px;font-size:15px}
.brand b{color:var(--cyan);text-shadow:0 0 12px rgba(56,214,255,.45)}
.brand span{color:var(--dim);font-weight:600}
.stat{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--dim)}
.dot{width:9px;height:9px;border-radius:50%;background:var(--cyanDim);box-shadow:0 0 8px var(--cyan)}
.dot.attack{background:var(--warn);box-shadow:0 0 10px var(--warn);animation:pulse 1s infinite}
.dot.solved{background:var(--ok);box-shadow:0 0 12px var(--ok)}
@keyframes pulse{50%{opacity:.35}}
main{flex:1;padding:16px 14px 8px}
footer{padding:10px 14px 16px;font-size:11px;line-height:1.5;color:var(--dim);border-top:1px solid var(--edge2)}
footer b{color:var(--warn)}
.screen{display:none}
.screen.on{display:block}
h1{font-size:20px;margin:.2em 0 .1em;letter-spacing:.5px}
h2{font-size:15px;margin:0 0 10px;color:var(--cyan);font-weight:700}
p{line-height:1.55;color:#b7c8d6}
.rune{color:var(--cyanDim);letter-spacing:6px;font-size:12px;margin:4px 0 14px}
.btn{
  font-family:var(--mono);font-size:14px;font-weight:700;cursor:pointer;
  color:#04121a;background:var(--cyan);border:0;border-radius:8px;padding:11px 16px;
  box-shadow:0 0 18px rgba(56,214,255,.25);
}
.btn:active{transform:translateY(1px)}
.btn.ghost{background:transparent;color:var(--cyan);border:1px solid var(--edge)}
.btn.small{padding:7px 10px;font-size:12px}
.btn:disabled{opacity:.35;cursor:not-allowed;box-shadow:none}
.stages{display:flex;flex-direction:column;gap:10px;margin-top:8px}
.stage{
  display:flex;align-items:center;gap:12px;text-align:left;width:100%;
  background:var(--panel);border:1px solid var(--edge);border-radius:10px;padding:12px 14px;
  color:var(--ink);font-family:var(--mono);cursor:pointer;
}
.stage:disabled{opacity:.4;cursor:not-allowed}
.stage .n{font-size:18px;font-weight:800;color:var(--cyan);min-width:22px}
.stage .t{font-weight:700}
.stage .d{font-size:12px;color:var(--dim);margin-top:2px}
.stage .chk{margin-left:auto;color:var(--ok);font-weight:800}
#term{
  background:#040a10;border:1px solid var(--edge);border-radius:10px;
  padding:12px;height:46vh;min-height:230px;overflow-y:auto;
  font-size:13px;line-height:1.5;white-space:pre-wrap;word-break:break-word;
  box-shadow:inset 0 0 40px rgba(0,40,60,.25);
}
#term .sys{color:var(--cyanDim)}
#term .cmd{color:var(--cyan)}
#term .ok{color:var(--ok)}
#term .bad{color:var(--bad)}
#term .deny{color:var(--dim)}
#term .info{color:#b7c8d6}
.cursor::after{content:"\2588";color:var(--cyan);animation:bl 1s steps(1) infinite}
@keyframes bl{50%{opacity:0}}
.bar{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-top:10px}
.seg{display:flex;border:1px solid var(--edge);border-radius:8px;overflow:hidden}
.seg button{background:transparent;color:var(--dim);border:0;padding:7px 9px;font-family:var(--mono);font-size:12px;cursor:pointer}
.seg button.sel{background:var(--edge);color:var(--cyan)}
.spd{margin-left:auto;font-size:11px;color:var(--dim)}
.hint{background:var(--edge2);border-left:3px solid var(--cyan);border-radius:6px;padding:10px 12px;margin:12px 0;font-size:13px;color:#bcd0de}
.hint code{color:var(--cyan)}
.pad{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;max-width:240px;margin-top:12px}
.pad button{padding:14px 0;font-size:18px;font-weight:700;font-family:var(--mono);background:var(--panel);color:var(--ink);border:1px solid var(--edge);border-radius:10px;cursor:pointer}
.pad button:active{background:var(--edge)}
.pad .wide{grid-column:span 1}
.entry{font-size:26px;letter-spacing:10px;text-align:center;color:var(--cyan);margin:14px 0 2px;min-height:34px;text-shadow:0 0 14px rgba(56,214,255,.4)}
.row{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.win{text-align:center;padding:10px 0}
.win h1{color:var(--ok);text-shadow:0 0 20px rgba(63,240,160,.5);font-size:24px}
.grant{font-size:12px;color:var(--ok);white-space:pre;line-height:1.15;margin:14px 0;overflow-x:auto}
a{color:var(--cyan)}
:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}
@media (prefers-reduced-motion:reduce){.dot.attack{animation:none}.cursor::after{animation:none}}
@keyframes shake{10%,90%{transform:translateX(-1px)}30%,70%{transform:translateX(-5px)}40%,60%{transform:translateX(4px)}50%{transform:translateX(5px)}}
.shake{animation:shake .38s}
@keyframes flashok{0%{box-shadow:inset 0 0 0 2px var(--ok),inset 0 0 70px rgba(63,240,160,.55)}100%{box-shadow:inset 0 0 40px rgba(0,40,60,.25)}}
.flashok{animation:flashok .7s}
#mute{padding:5px 8px}
@media (prefers-reduced-motion:reduce){.shake,.flashok{animation:none}}
#scenario{margin-top:12px}
.scen{background:var(--panel);border:1px solid var(--edge);border-radius:8px;padding:10px 12px;font-size:13px}
.scen .lab{color:var(--dim);font-size:11px;letter-spacing:1px;margin-right:8px}
.scen b{color:var(--cyan)}
.reconhdr{color:var(--cyanDim);font-size:11px;letter-spacing:1px;margin:12px 0 6px}
.clue{font-size:13px;color:#bcd0de;padding:2px 0}
.clue::before{content:"\25B8";color:var(--cyan);margin-right:8px}
.pkt{font-size:12px;color:#bcd0de;padding:6px 8px;margin:3px 0;background:#040a10;
  border:1px solid var(--edge);border-radius:6px;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pkt:active{background:var(--edge)}
.pkt .pno{color:var(--dim);margin-right:8px}
.pkt .pproto{display:inline-block;min-width:42px;color:var(--cyan);margin-right:8px}
.guessrow{display:flex;gap:8px;margin-top:14px}
#guess{flex:1;min-width:0;font-family:var(--mono);font-size:16px;color:var(--cyan);
  background:#040a10;border:1px solid var(--edge);border-radius:8px;padding:11px 12px;
  letter-spacing:1px;box-shadow:inset 0 0 24px rgba(0,40,60,.25)}
#guess::placeholder,#guessUser::placeholder{color:var(--dim);letter-spacing:0}
#guessUser{width:100%;font-family:var(--mono);font-size:16px;color:var(--cyan);
  background:#040a10;border:1px solid var(--edge);border-radius:8px;padding:11px 12px;
  letter-spacing:1px;margin-top:12px;box-shadow:inset 0 0 24px rgba(0,40,60,.25)}
#cliWrap{margin-top:14px}
.clihdr{color:var(--cyanDim);font-size:11px;margin-bottom:5px}
.clihdr b{color:var(--cyan)}
.cli{display:flex;align-items:center;gap:8px;background:#040a10;border:1px solid var(--edge);
  border-radius:8px;padding:8px 10px}
.cli .cliP{color:var(--ok);font-weight:700}
#cli{flex:1;min-width:0;background:transparent;border:0;outline:none;color:var(--ink);
  font-family:var(--mono);font-size:14px}
#cli::placeholder,#mCli::placeholder,#mAns::placeholder,#mUser::placeholder{color:var(--dim)}
#mClock{display:flex;justify-content:space-between;align-items:baseline;margin:2px 0 8px}
#mTime{font-family:var(--mono);font-size:22px;font-weight:700;color:var(--cyan);text-shadow:0 0 12px rgba(56,214,255,.4)}
#mBest{font-size:12px;color:var(--dim)}
.modeToggle{display:flex;gap:8px;margin:2px 0 14px}
.mt{flex:1;font-family:var(--mono);font-size:14px;font-weight:700;cursor:pointer;color:var(--dim);
  background:var(--panel);border:1px solid var(--edge);border-radius:9px;padding:11px 0}
.mt.on{color:#04121a;background:var(--cyan);border-color:var(--cyan);box-shadow:0 0 16px rgba(56,214,255,.25)}
#ledPanel{margin-top:16px;border-top:1px solid var(--edge2);padding-top:10px}
.ledRow{display:flex;align-items:center;gap:8px;margin-top:6px;flex-wrap:wrap}
.ledBtn{font-family:var(--mono);font-size:12px;cursor:pointer;color:var(--ink);background:var(--panel);
  border:1px solid var(--edge);border-radius:7px;padding:7px 12px}
.ledBtn.on{border-color:var(--cyan);color:var(--cyan)}
.ledSwatch{width:22px;height:22px;border-radius:6px;border:2px solid var(--edge);cursor:pointer;display:inline-block;vertical-align:middle}
.ledSwatch.on{border-color:#fff}
#bClockWrap{position:relative;height:26px;background:#040a10;border:1px solid var(--edge);border-radius:8px;overflow:hidden;margin:4px 0 12px}
#bBar{position:absolute;left:0;top:0;bottom:0;width:100%;background:linear-gradient(90deg,var(--ok),var(--warn));transition:width .25s linear}
#bClock{position:absolute;left:0;right:0;top:0;line-height:26px;text-align:center;font-weight:700;font-size:13px;color:#04121a}
#bFeed{background:#040a10;border:1px solid var(--edge);border-radius:10px;padding:10px 12px;min-height:90px;
  font-size:13px;line-height:1.5;white-space:pre-wrap;word-break:break-word}
#bFeed .al{color:var(--bad)} #bFeed .nf{color:var(--dim)} #bFeed .ok{color:var(--ok)} #bFeed .sys{color:var(--cyanDim)}
#bOptions{display:flex;flex-direction:column;gap:8px;margin-top:12px}
.bOpt{text-align:left;font-family:var(--mono);font-size:13px;cursor:pointer;color:var(--ink);background:var(--panel);
  border:1px solid var(--edge);border-radius:9px;padding:12px 14px}
.bOpt:active{background:var(--edge)}
.bOpt:disabled{opacity:.4;cursor:not-allowed}
#bGoal{font-size:12px;color:var(--cyan);margin:2px 0 8px}
#bCliWrap{margin-top:12px}
#bCli{flex:1;min-width:0;background:transparent;border:0;outline:none;color:var(--ink);font-family:var(--mono);font-size:14px}
#bCli::placeholder{color:var(--dim)}
#mTime.record{color:var(--ok);text-shadow:0 0 14px rgba(63,240,160,.5)}
.mSteps{display:flex;gap:6px;margin:4px 0 14px}
.mSteps .mStep{flex:1;text-align:center;font-size:10px;padding:7px 2px;border:1px solid var(--edge);
  border-radius:6px;color:var(--dim);background:#040a10;line-height:1.3}
.mSteps .mStep .sn{display:block;font-size:13px;font-weight:700}
.mSteps .mStep.on{border-color:var(--cyan);color:var(--cyan);box-shadow:0 0 12px rgba(56,214,255,.2)}
.mSteps .mStep.done{border-color:var(--ok);color:var(--ok)}
#mCliWrap{margin:12px 0}
#mCli,#mUser,#mAns{font-family:var(--mono);font-size:15px;color:var(--cyan);background:#040a10;
  border:1px solid var(--edge);border-radius:8px;padding:10px 12px}
#mUser{width:100%;margin-bottom:8px}
#mCli{flex:1;min-width:0;background:transparent;border:0;outline:none;font-size:14px;color:var(--ink)}
.mcard{background:var(--panel);border:1px solid var(--edge);border-radius:10px;padding:12px 14px;margin:6px 0;font-size:13px}
.mcard b{color:var(--cyan)}
.mrow{font-size:12px;color:#bcd0de;padding:6px 8px;margin:3px 0;background:#040a10;border:1px solid var(--edge);
  border-radius:6px;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mrow:active{background:var(--edge)}
.mrow .pno{color:var(--dim);margin-right:8px}
.mrow .pip{display:inline-block;min-width:92px;color:var(--cyan);margin-right:8px}
.form{display:flex;flex-direction:column;gap:10px;margin-top:12px}
.form label{display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--dim)}
.form input,.form select{font-family:var(--mono);font-size:15px;color:var(--ink);
  background:#040a10;border:1px solid var(--edge);border-radius:8px;padding:9px 11px}
.form input:focus,.form select:focus{outline:none;border-color:var(--cyan)}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="brand"><b>CYBER</b>CHUCK <span>// hacking 101</span></div>
    <div class="stat">
      <button class="btn ghost small" id="mute" onclick="toggleSound()" title="sound on/off">&#128266;</button>
      <span id="statTxt">idle</span><span class="dot" id="dot"></span>
    </div>
  </header>

  <main>
    <!-- BOOT -->
    <section class="screen on" id="boot">
      <h1>Welcome to the sandbox.</h1>
      <div class="rune">&#5792; PRIVACY IS CURRENCY &#5792;</div>
      <p>This little dongle is a self-contained hacking range. Everything you attack
      lives inside it &mdash; nothing here touches the internet or any real system.</p>
      <p>Lesson 1: <b style="color:var(--cyan)">cracking a password from clues</b>. Four
      difficulties, each with less hand-holding than the last. Take your time &mdash; you
      can slow the walkthrough down to any pace you like.</p>
      <div class="row"><button class="btn" onclick="go('home')">Start &raquo;</button></div>
    </section>

    <!-- MAIN MENU (lessons) -->
    <section class="screen" id="home">
      <h2>Main menu</h2>
      <div class="modeToggle">
        <button id="mAtk" class="mt" onclick="setMode('attack')">&#9876;&#65039; Attack</button>
        <button id="mDef" class="mt" onclick="setMode('defend')">&#128737;&#65039; Defend</button>
      </div>
      <div class="stages" id="lessons"></div>
      <div id="missionCard"></div>
      <div class="row" style="margin-top:14px">
        <button class="btn" id="continueBtn" style="display:none" onclick="continueProgress()">Continue</button>
        <button class="btn ghost small" onclick="resetProgress()">Reset progress</button>
      </div>
      <p style="font-size:12px;color:var(--dim);margin-top:10px">
        Progress saves to the dongle automatically &mdash; unplug it and pick up where you left off.</p>
      <div id="ledPanel">
        <div class="clihdr">// status LED</div>
        <div class="ledRow">
          <button class="ledBtn" onclick="setLed(0)">Off</button>
          <button class="ledBtn" onclick="setLed(1)">Auto</button>
          <span id="ledSw"></span>
        </div>
      </div>
    </section>

    <!-- MENU -->
    <section class="screen" id="menu">
      <h2 id="menuTitle">Lesson 1 &mdash; Password guessing</h2>
      <div class="stages" id="stages"></div>
      <div class="row" style="margin-top:12px">
        <button class="btn ghost small" id="customBtn" onclick="go('custom')">&#43; Custom case</button>
        <button class="btn ghost small" onclick="go('home')">&laquo; All lessons</button>
      </div>
    </section>

    <!-- CUSTOM CASE -->
    <section class="screen" id="custom">
      <h2>Custom case</h2>
      <p style="font-size:13px;color:#b7c8d6;line-height:1.55">Enter a target's details the
        way recon would surface them. The sandbox builds a password from them so you can show
        how guessable that style is. <b style="color:var(--warn)">Use fake or consenting-demo
        data only.</b></p>
      <div class="form">
        <label>Name<input id="c_name" type="text" autocomplete="off" placeholder="Alex Rivera"></label>
        <label>Pet's name<input id="c_pet" type="text" autocomplete="off" placeholder="Bella"></label>
        <label>Kid's name<input id="c_kid" type="text" autocomplete="off" placeholder="Noah"></label>
        <label>Birth year<input id="c_year" type="text" inputmode="numeric" autocomplete="off" placeholder="1990"></label>
        <label>Favorite team<input id="c_team" type="text" autocomplete="off" placeholder="Lakers"></label>
        <label>City<input id="c_city" type="text" autocomplete="off" placeholder="Denver"></label>
        <label>Difficulty
          <select id="c_diff">
            <option value="1">Easy &mdash; name + year</option>
            <option value="2">Medium &mdash; two facts mashed</option>
            <option value="3">Hard &mdash; leet + symbol</option>
          </select>
        </label>
      </div>
      <div class="row" style="margin-top:12px">
        <button class="btn" onclick="buildCustomCase()">Build case &raquo;</button>
        <button class="btn ghost" onclick="go('menu')">Back</button>
      </div>
    </section>

    <!-- STAGE -->
    <section class="screen" id="stage">
      <h2 id="stageTitle"></h2>
      <div id="term"></div>
      <div class="bar" id="playbar">
        <button class="btn ghost small" id="bPlay" onclick="P.toggle()">&#9654; Play</button>
        <button class="btn ghost small" id="bBack" onclick="P.step(-1)">&#9198;</button>
        <button class="btn ghost small" id="bFwd" onclick="P.step(1)">&#9197;</button>
        <button class="btn ghost small" onclick="P.restart()">&#8635; Restart</button>
        <div class="seg" id="speed"></div>
        <span class="spd" id="spdTxt">1&times;</span>
      </div>

      <div id="attack">
        <div id="scenario"></div>
        <div id="clues"></div>
        <div id="hints"></div>
        <input id="guessUser" type="text" inputmode="text" autocomplete="off"
               autocapitalize="off" autocorrect="off" spellcheck="false"
               placeholder="username" style="display:none" />
        <div class="guessrow">
          <input id="guess" type="text" inputmode="text" autocomplete="off"
                 autocapitalize="off" autocorrect="off" spellcheck="false"
                 placeholder="type the password" />
          <button class="btn" onclick="submitGuess()">Try</button>
        </div>
        <div id="guessHint" style="font-size:11px;color:var(--dim);margin-top:8px">
          Type a guess and hit Enter. Read the recon &mdash; the password is built from it.</div>
        <div id="cliWrap" style="display:none">
          <div class="clihdr">// decoder CLI &mdash; run <b>decode &lt;string&gt;</b> to base64-decode</div>
          <div class="cli"><span class="cliP">$</span>
            <input id="cli" type="text" autocomplete="off" autocapitalize="off"
                   autocorrect="off" spellcheck="false" placeholder="decode <base64 string>" /></div>
        </div>
        <div class="row">
          <button class="btn" id="bAuto" onclick="autoAttack()">&#9889; Run wordlist attack</button>
          <button class="btn ghost" id="bNewCase" onclick="newCase()">New case</button>
          <button class="btn ghost" onclick="stopAll()">Stop</button>
          <button class="btn ghost" onclick="go('menu')">Menu</button>
        </div>
      </div>
    </section>

    <!-- BLUE TEAM (live defense) -->
    <section class="screen" id="blue">
      <h2 id="bTitle">Incident</h2>
      <div id="bGoal"></div>
      <div id="bFeed"></div>
      <div id="bHint"></div>
      <div class="cli" id="bCliWrap"><span class="cliP">#</span>
        <input id="bCli" type="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" placeholder="command - try: help, logs, status" /></div>
      <div class="row" style="margin-top:12px">
        <button class="btn ghost" onclick="go('home')">Menu</button>
        <button class="btn ghost small" onclick="bReset()">New incident</button>
      </div>
    </section>

    <!-- MISSION (end-to-end) -->
    <section class="screen" id="mission">
      <h2 id="mTitle">Mission &mdash; Full Chain</h2>
      <div id="mClock"><span id="mTime">0.0s</span><span id="mBest"></span></div>
      <div id="mSteps" class="mSteps"></div>
      <div id="mScenario"></div>
      <div id="mData"></div>
      <div id="mHint"></div>
      <div id="mCliWrap">
        <div class="clihdr" id="mCliHdr"></div>
        <div class="cli"><span class="cliP">$</span>
          <input id="mCli" type="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" placeholder="" /></div>
      </div>
      <input id="mUser" type="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" placeholder="username" style="display:none" />
      <div class="guessrow">
        <input id="mAns" type="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" placeholder="" />
        <button class="btn" onclick="mSubmit()">Submit</button>
      </div>
      <div class="row" style="margin-top:12px">
        <button class="btn ghost" onclick="go('home')">Menu</button>
        <button class="btn ghost small" onclick="mReset()">Restart mission</button>
      </div>
    </section>

    <!-- WIN -->
    <section class="screen" id="win">
      <div class="win">
        <h1>ACCESS GRANTED</h1>
        <div class="grant" id="grant"></div>
        <p id="winMsg">Lesson complete.</p>
        <p style="color:var(--dim)">More lessons ship in future firmware drops &mdash;
        traffic sniffing and network enumeration are next.</p>
        <div class="row" style="justify-content:center">
          <button class="btn" onclick="go('home')">Back to lessons</button>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <b>For practice only.</b> No certificate, no score that means anything &mdash; just reps.
    Brute forcing a login you don&rsquo;t own is a crime. Keep it in the sandbox.
    Open source: inspect the firmware, this box phones no one home.
  </footer>
</div>

<script>
const $=s=>document.querySelector(s);
const TERM=$('#term');
let ST={ssid:'CyberChuck_Sandbox',hasVoice:false,solved:[false,false,false,false],solved2:[false,false,false,false],solved3:[false,false,false,false],solved4:[false,false,false,false],version:'0.1',mstage:0,mdone:false,solvedB:[false,false,false,false],ledMode:1,ledColor:'#00C8FF'};
let mode='attack';   // 'attack' (red) or 'defend' (blue)
let bStage=0;
let cur=0;                 // current stage index
const STAGES=[
 {t:'Learn (guided)', d:'How recon turns into a cracked password.'},
 {t:'Easy',           d:'Name + year. The clues point right at it.'},
 {t:'Medium',         d:'Two facts mashed together, capitalized.'},
 {t:'Hard',           d:'Leet swaps + a symbol. Recon only, no pattern hint.'},
];

// ---------- screen routing ----------
function go(id){
  if(typeof stopBlue==='function') stopBlue();
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('on'));
  $('#'+id).classList.add('on');
  if(id==='blue') enterBlue();
  if(id==='home') renderHome();
  if(id==='menu') renderMenu();
  if(id==='stage') enterStage();
  if(id==='mission') enterMission();
  window.scrollTo(0,0);
}
const LESSONS=[
 {id:1,t:'Password guessing', d:'Crack a client\'s password from recon. 4 difficulties.', ready:true},
 {id:2,t:'Login brute force', d:'Beat a login: default creds, user enumeration, lockout.', ready:true},
 {id:3,t:'Traffic sniffing',  d:'Read a captured trace, find creds in the clear.', ready:true},
 {id:4,t:'Network enumeration',d:'Scan the subnet, find the weak host. Nmap basics.', ready:true},
];
let lesson=1;                       // which lesson is active (1, 2 or 3)
const STAGES2=[
 {t:'Learn (guided)', d:'How logins fall: defaults, enumeration, lockout.'},
 {t:'Easy',           d:'Default credentials. Try the factory login.'},
 {t:'Medium',         d:'Find the real username, then its weak password.'},
 {t:'Hard',           d:'Enumerate + mangled password + lockout. No hints.'},
];
const STAGES3=[
 {t:'Learn (guided)', d:'How sniffing exposes plaintext logins.'},
 {t:'Easy',           d:'A short capture. Find the plaintext password.'},
 {t:'Medium',         d:'Filter the noise, find the one HTTP POST.'},
 {t:'Hard',           d:'Base64 Basic-Auth. Spot it and decode it. No hints.'},
];
const STAGES4=[
 {t:'Learn (guided)', d:'How enumeration finds the way in.'},
 {t:'Easy',           d:'Small subnet. Find the host running a plaintext service.'},
 {t:'Medium',         d:'More hosts. Spot the wide-open, no-auth service.'},
 {t:'Hard',           d:'Recognise the legacy/vulnerable service. No hints.'},
];
function solvedArr(id){ return id===4?ST.solved4 : id===3?ST.solved3 : id===2?ST.solved2 : ST.solved; }
async function renderHome(){
  try{ const s=await (await fetch('/api/state')).json(); Object.assign(ST,s);}catch(e){}
  $('#mAtk').classList.toggle('on', mode==='attack');
  $('#mDef').classList.toggle('on', mode==='defend');
  const box=$('#lessons'); box.innerHTML='';
  if(mode==='defend'){
    BLUE_STAGES.forEach((b4,i)=>{
      const b=document.createElement('button'); b.className='stage';
      b.innerHTML=`<span class="n">${i+1}</span><span><span class="t">${b4.t}</span>
        <div class="d">${b4.d}</div></span>${ST.solvedB[i]?'<span class="chk" style="color:var(--ok)">&#10003;</span>':''}`;
      b.onclick=()=>{ bStage=i; go('blue'); };
      box.appendChild(b);
    });
    $('#continueBtn').style.display='none';
    $('#missionCard').innerHTML='';
  } else {
    LESSONS.forEach(L=>{
      const arr = L.ready ? solvedArr(L.id) : null;
      const done = arr ? arr.filter(Boolean).length : 0;
      const complete = arr && done===4;
      const b=document.createElement('button');
      b.className='stage'; b.disabled=!L.ready;
      b.innerHTML=`<span class="n">${L.id}</span><span><span class="t">${L.t}</span>
        <div class="d">${L.ready?L.d:'&#128274; '+L.d}</div></span>
        ${L.ready?`<span class="chk" style="color:${complete?'var(--ok)':'var(--dim)'}">${done}/4</span>`:''}`;
      if(L.ready) b.onclick=()=>{ lesson=L.id; go('menu'); };
      box.appendChild(b);
    });
    const cont=$('#continueBtn'); if(cont){
      const next=nextUnsolved();
      if(next){ cont.style.display=''; cont.textContent='Continue \u2014 Lesson '+next.lesson+' \u00b7 '+DIFF_LABEL[next.stage]; }
      else cont.style.display='none';
    }
    renderMissionCard();
  }
  renderLed();
}
function setMode(m){ mode=m; renderHome(); }
function renderMissionCard(){
  const box=$('#missionCard'); if(!box) return;
  const allDone = ST.solved.every(Boolean)&&ST.solved2.every(Boolean)&&ST.solved3.every(Boolean)&&ST.solved4.every(Boolean);
  const label = ST.mdone ? 'Replay âœ“' : (ST.mstage>0 ? 'Continue Â· step '+(ST.mstage+1)+'/4' : 'Start');
  box.innerHTML =
    `<button class="stage" style="margin-top:4px" onclick="go('mission')">
       <span class="n">&#9733;</span>
       <span><span class="t">Final Mission &mdash; Full Chain</span>
       <div class="d">One target: scan &rarr; port-scan &rarr; sniff &rarr; log in.</div></span>
       <span class="chk" style="color:${ST.mdone?'var(--ok)':'var(--cyan)'}">${label}</span>
     </button>`;
}
function nextUnsolved(){
  for(const id of [1,2,3,4]){
    const L=LESSONS[id-1]; if(!L||!L.ready) continue;
    const arr=solvedArr(id); const i=arr.findIndex(x=>!x);
    if(i>=0) return {lesson:id, stage:i};
  }
  return null;
}
function continueProgress(){ const n=nextUnsolved(); if(n){ lesson=n.lesson; cur=n.stage; go('stage'); } }

// ================= LED control =================
const LED_SWATCHES=['#00C8FF','#3FF0A0','#FFB454','#FF5C6A','#B46BFF','#FFFFFF'];
function hex2rgb(h){ h=h.replace('#',''); return [parseInt(h.slice(0,2),16),parseInt(h.slice(2,4),16),parseInt(h.slice(4,6),16)]; }
function renderLed(){
  const row=$('#ledSw'); if(!row) return;
  const btns=document.querySelectorAll('#ledPanel .ledBtn');
  btns.forEach((b,i)=>b.classList.toggle('on',(i===0&&ST.ledMode===0)||(i===1&&ST.ledMode===1)));
  row.innerHTML = LED_SWATCHES.map(h=>`<span class="ledSwatch${(ST.ledMode===2&&(ST.ledColor||'').toUpperCase()===h)?' on':''}" style="background:${h}" onclick="setLedColor('${h}')"></span>`).join(' ');
}
async function setLed(m){ ST.ledMode=m; try{ await post('/api/led',{mode:m}); }catch(e){} renderLed(); SFX.blip(); }
async function setLedColor(h){ const c=hex2rgb(h); ST.ledMode=2; ST.ledColor=h.toUpperCase();
  try{ await post('/api/led',{mode:2,r:c[0],g:c[1],b:c[2]}); }catch(e){} renderLed(); SFX.blip(); }

// ================= BLUE TEAM (live defense) =================
const BLUE_STAGES=[
 {t:'Learn (guided)', d:'What an alert is, and how to shut an attack down.'},
 {t:'Easy',           d:'One clear attack. Stop it before the timer runs out.'},
 {t:'Medium',         d:'Pick the right response under pressure.'},
 {t:'Hard',           d:'Decoy alerts, short clock, no hints.'},
];
let BD=null, bTimer=null, bDeadline=0, bLive=false;
function bline(t,cls){ const d=document.createElement('div'); if(cls)d.className=cls; d.textContent=t; const fe=$('#bFeed'); fe.appendChild(d); fe.scrollTop=fe.scrollHeight; }
function stopBlue(){ bLive=false; clearInterval(bTimer); }
async function enterBlue(){
  stopBlue(); $('#bFeed').innerHTML=''; $('#bHint').innerHTML='';
  const ci=$('#bCli'); if(ci){ ci.value=''; ci.disabled=false; }
  $('#bTitle').innerHTML='Incident &nbsp;<span style="color:var(--dim);font-size:12px">'+DIFF_LABEL[bStage]+'</span>';
  try{ BD=await post('/api/blue/newcase',{stage:bStage}); }catch(e){ BD=null; }
  if(!BD){ bline('(no response from sensor)','al'); return; }
  bline('>_ live defense console','sys');
  if(bStage===0) bline("An attack is in progress. Investigate with 'logs' and 'status', then contain it before the clock hits zero. 'help' lists commands.",'sys');
  bline(''); bline('INCIDENT: '+BD.title,'al');
  (BD.alerts||'').split('\n').forEach(l=> bline(l, l.indexOf('[ALERT]')>=0?'al':'nf'));
  bline(''); bline(BD.goal,'sys');
  $('#bHint').innerHTML = BD.hint ? `<div class="hint">${BD.hint}</div>` : '';
  bLive=true;
  if(ci) ci.focus();
}
function bTick(){ /* countdown removed - defense is untimed */ }
async function bCmd(){
  if(!bLive){ return; }
  const el=$('#bCli'); if(!el) return; const cmd=el.value.trim(); if(!cmd) return;
  el.value=''; bline('# '+cmd,'sys'); SFX.blip();
  let r; try{ r=await post('/api/blue/cmd',{stage:bStage,cmd}); }catch(e){ bline('  (no response)','al'); return; }
  (r.out||'').split('\n').forEach(l=> bline('  '+l, r.contained?'ok':'nf'));
  if(r.contained) bWin();
}
function bWin(){
  stopBlue(); SFX.win();
  bline(''); bline('ATTACK STOPPED - incident contained.','ok');
  ST.solvedB[bStage]=true;
  const ci=$('#bCli'); if(ci) ci.disabled=true;
  if(bStage<3) bline('next incident unlocked.','sys');
}
function bBreach(){
  stopBlue(); SFX.deny();
  $('#bBar').style.width='0%'; $('#bClock').textContent='BREACHED';
  bline(''); bline('BREACHED - the attack got through. Hit "New incident" to retry.','al');
  const ci=$('#bCli'); if(ci) ci.disabled=true;
}
function bReset(){ go('blue'); }
document.addEventListener('keydown',e=>{
  if($('#blue').classList.contains('on') && e.key==='Enter' && document.activeElement===$('#bCli')){ e.preventDefault(); bCmd(); }
});

// ================= FINAL MISSION (end-to-end) =================
let MD=null;                 // mission data from the server
let mStart=0, mTimer=null, mRunning=false, mTimed=false;
function fmtT(ms){ return (ms/1000).toFixed(1)+'s'; }
function showBest(){ const b=$('#mBest'); if(b) b.textContent = (MD&&MD.best>0)?('best '+fmtT(MD.best)):'no record yet'; }
function startClock(){ mStart=Date.now(); mRunning=true; clearInterval(mTimer);
  mTimer=setInterval(()=>{ if(mRunning){ const t=$('#mTime'); if(t) t.textContent=fmtT(Date.now()-mStart); } },100); }
function stopClock(){ mRunning=false; clearInterval(mTimer); }
const M_STEPS=['Enumerate','Port-scan','Sniff','Log in'];
const M_TITLES=['Step 1 \u00b7 Enumerate the subnet','Step 2 \u00b7 Port-scan the host',
                'Step 3 \u00b7 Sniff the traffic','Step 4 \u00b7 Log in'];

async function enterMission(){
  try{ MD = await post('/api/mission/state',{}); }catch(e){ MD=null; }
  if(!MD){ return; }
  showBest();
  const t=$('#mTime'); if(t){ t.classList.remove('record'); t.textContent=fmtT(0); }
  if(!MD.done && MD.stage===0){ mTimed=true; startClock(); } else { mTimed=false; stopClock(); }
  renderMissionStep();
}

function mStepBar(active){
  return M_STEPS.map((s,i)=>{
    const cls = i<MD.stage?'done' : i===MD.stage?'on':'';
    return `<div class="mStep ${cls}"><span class="sn">${i<MD.stage?'\u2713':i+1}</span>${s}</div>`;
  }).join('');
}

function renderMissionStep(){
  const st = MD.done?4:MD.stage;
  $('#mSteps').innerHTML = mStepBar();
  // reset inputs/cli
  const cli=$('#mCli'), ans=$('#mAns'), usr=$('#mUser'), cw=$('#mCliWrap');
  usr.style.display='none'; ans.value=''; cli.value='';
  if(MD.done){ return missionComplete(); }

  $('#mTitle').innerHTML = 'Final Mission &nbsp;<span style="color:var(--dim);font-size:12px">'+(st+1)+'/4</span>';
  const data=$('#mData'), scen=$('#mScenario'), hint=$('#mHint');

  if(st===0){
    scen.innerHTML=`<div class="mcard">${M_TITLES[0]}<br>Scan <b>${MD.subnet}</b>, open the hosts, and enter the IP of the one running a plaintext service.</div>`;
    data.innerHTML='<div class="reconhdr">// live hosts \u2014 tap to port-scan</div>'+
      MD.hosts.map((h,i)=>`<div class="mrow" onclick="mShowHost(${i})"><span class="pno">${i+1}</span><span class="pip">${h.ip}</span>${h.name}</div>`).join('');
    hint.innerHTML='<div class="hint">Telnet (port 23) sends logins in the clear \u2014 that host is the way in.</div>';
    cw.style.display='block'; $('#mCliHdr').innerHTML='// recon CLI \u2014 <b>scan</b> / <b>nmap &lt;ip&gt;</b>'; cli.placeholder='scan   or   nmap <ip>';
    ans.placeholder='the weak host IP';
  } else if(st===1){
    scen.innerHTML=`<div class="mcard">${M_TITLES[1]}<br>Target locked: <b>${MD.vip}</b>. Port-scan it and enter the open plaintext port (number).</div>`;
    data.innerHTML='';
    hint.innerHTML='<div class="hint">Run <code>nmap '+MD.vip+'</code> in the CLI. The plaintext service is telnet.</div>';
    cw.style.display='block'; $('#mCliHdr').innerHTML='// recon CLI \u2014 <b>nmap '+MD.vip+'</b>'; cli.placeholder='nmap '+MD.vip;
    ans.placeholder='the open plaintext port #';
  } else if(st===2){
    scen.innerHTML=`<div class="mcard">${M_TITLES[2]}<br>You're sniffing <b>${MD.vip}</b>. Open the packets and read the password off the wire.</div>`;
    data.innerHTML='<div class="reconhdr">// captured packets \u2014 tap to open</div>'+
      MD.packets.map((pk,i)=>`<div class="mrow" onclick="mShowPkt(${i})"><span class="pno">${i+1}</span><span class="pip">${pk.proto}</span>${pk.src} &rarr; ${pk.dst}</div>`).join('');
    hint.innerHTML='<div class="hint">Telnet is plaintext \u2014 the password line is right there in a packet.</div>';
    cw.style.display='none';
    ans.placeholder='the sniffed password';
  } else {
    scen.innerHTML=`<div class="mcard">${M_TITLES[3]}<br>Log in to <b>${MD.vip}</b>. You sniffed the password; the username was in the login packet.</div>`;
    data.innerHTML='';
    hint.innerHTML='<div class="hint">Username: <b>'+MD.user+'</b> (from the login prompt). Use the password you sniffed.</div>';
    cw.style.display='none';
    usr.style.display='block'; usr.value=''; ans.placeholder='password';
  }
  (st===3?usr:ans).focus();
}

function mShowHost(i){ const h=MD.hosts[i]; if(!h)return;
  line('','info'); line('-- nmap '+h.ip+'   ('+h.name+')','sys');
  (h.ports||'').split('\n').forEach(l=>line('   '+l,'info')); SFX.blip(); scrollMData(); }
function mShowPkt(i){ const pk=MD.packets[i]; if(!pk)return;
  line('','info'); line('-- '+pk.proto+'  '+pk.src+' -> '+pk.dst,'sys');
  if(pk.info) line('   '+pk.info,'deny'); (pk.payload||'').split('\n').forEach(l=>line('   '+l,'info')); SFX.blip(); }
function scrollMData(){}

async function mSubmit(){
  if(!MD||MD.done) return;
  const st=MD.stage, ans=$('#mAns').value.trim();
  if(!ans) return;
  const user = st===3 ? $('#mUser').value.trim() : '';
  if(st===3 && !user){ line('  enter the username too','deny'); return; }
  line('> '+(st===3?user+' : '+ans:'submit: '+ans),'cmd');
  let r; try{ r=await post('/api/mission/check',{stage:st,answer:ans,user:user}); }catch(e){ line('  (no response)','bad'); return; }
  if(r.correct){
    SFX.win(); flashOk();
    line('  '+['host found','port confirmed','password recovered','ACCESS GRANTED'][st],'ok');
    MD.stage=r.stage; MD.done=r.done; ST.mstage=r.stage; ST.mdone=r.done;
    setTimeout(renderMissionStep, 900);
  } else {
    SFX.deny(); shake($('#mAns'));
    line('  '+['not the weak host \u2014 keep scanning','wrong port \u2014 re-scan the host',
               'not the password \u2014 keep reading packets','login failed \u2014 check user + password'][st],'bad');
  }
}

async function missionComplete(){
  const elapsed = (mTimed && mRunning) ? (Date.now()-mStart) : 0;
  stopClock(); mTimed=false;
  $('#mTitle').innerHTML='Mission Complete';
  let recLine='';
  if(elapsed>0){
    const tEl=$('#mTime'); if(tEl) tEl.textContent=fmtT(elapsed);
    try{ const rr=await post('/api/mission/time',{ms:elapsed}); MD.best=rr.best;
      if(rr.record){ if(tEl) tEl.classList.add('record'); recLine='<br><b style="color:var(--ok)">NEW RECORD \u2014 '+fmtT(elapsed)+'</b>'; }
      else recLine='<br>Time '+fmtT(elapsed)+' \u00b7 best '+fmtT(MD.best);
    }catch(e){}
    showBest();
  }
  $('#mScenario').innerHTML='<div class="mcard" style="border-color:var(--ok)"><b style="color:var(--ok)">FULL CHAIN COMPLETE</b><br>'+
    'You scanned the network, found the weak host, port-scanned it, sniffed its traffic, and logged in \u2014 the whole kill chain on one target.'+recLine+'</div>';
  $('#mData').innerHTML=''; $('#mHint').innerHTML='';
  $('#mCliWrap').style.display='none'; $('#mUser').style.display='none';
  $('#mAns').parentElement.style.display='none';
  SFX.win();
}

async function mReset(){
  try{ MD=await post('/api/mission/reset',{}); }catch(e){}
  ST.mstage=0; ST.mdone=false; clearTerm();
  const t=$('#mTime'); if(t) t.classList.remove('record');
  mTimed=true; showBest(); startClock();
  $('#mAns').parentElement.style.display='flex';
  renderMissionStep();
}

// mission CLI + Enter handling
document.addEventListener('keydown',e=>{
  if(!$('#mission').classList.contains('on')) return;
  if(e.key==='Enter' && document.activeElement===$('#mCli')){ e.preventDefault(); mCli(); }
  if(e.key==='Enter' && (document.activeElement===$('#mAns')||document.activeElement===$('#mUser'))){ e.preventDefault(); mSubmit(); }
});
function mCli(){
  const el=$('#mCli'); if(!el)return; const cmd=el.value.trim(); if(!cmd)return;
  el.value=''; line('$ '+cmd,'cmd'); SFX.blip();
  const parts=cmd.split(/\s+/), c=parts[0].toLowerCase();
  if(c==='scan'||(c==='nmap'&&parts.length<2)){
    line('  host discovery on '+MD.subnet+' ...','sys');
    MD.hosts.forEach(h=>line('   '+h.ip+'   '+h.name,'info')); return;
  }
  if(c==='nmap'){
    const idx=MD.hosts.findIndex(h=>h.ip===parts[1]);
    if(idx<0){ line('   host down / not found','deny'); return; }
    mShowHost(idx); return;
  }
  line('  try:  scan  |  nmap <ip>','deny');
}
async function resetProgress(){
  try{ await post('/api/clear',{}); }catch(e){}
  ST.solved=[false,false,false,false]; ST.solved2=[false,false,false,false];
  renderHome();
}

function renderMenu(){
  const arr = solvedArr(lesson);
  const S   = lesson===4?STAGES4 : lesson===3?STAGES3 : lesson===2?STAGES2 : STAGES;
  const titles={1:'Lesson 1 &mdash; Password guessing',2:'Lesson 2 &mdash; Login brute force',3:'Lesson 3 &mdash; Traffic sniffing',4:'Lesson 4 &mdash; Network enumeration'};
  const mt=$('#menuTitle'); if(mt) mt.innerHTML = titles[lesson]||('Lesson '+lesson);
  const cb=$('#customBtn'); if(cb) cb.style.display = lesson===1?'':'none';
  const box=$('#stages'); box.innerHTML='';
  S.forEach((s,i)=>{
    const locked = i>0 && !arr[i-1];
    const b=document.createElement('button');
    b.className='stage'; b.disabled=locked;
    b.innerHTML=`<span class="n">${i+1}</span><span><span class="t">${s.t}</span>
      <div class="d">${locked?'Clear stage '+i+' to unlock':s.d}</div></span>
      ${arr[i]?'<span class="chk">&#10003;</span>':''}`;
    b.onclick=()=>{cur=i; go('stage');};
    box.appendChild(b);
  });
}

// ---------- terminal ----------
function line(text,cls){const d=document.createElement('div');if(cls)d.className=cls;d.textContent=text;TERM.appendChild(d);TERM.scrollTop=TERM.scrollHeight;return d;}
function clearTerm(){TERM.innerHTML='';}
const reduce=matchMedia('(prefers-reduced-motion:reduce)').matches;

// ---------- playback engine (shared by walkthrough + live attack) ----------
const P={
  speed:1, playing:false, token:0, paused:false, resume:null,
  script:[], idx:0, mode:'script', audio:null,
  setSpeed(v){this.speed=v;$('#spdTxt').textContent=v+'\u00d7';
    document.querySelectorAll('#speed button').forEach(b=>b.classList.toggle('sel',+b.dataset.v===v));},
  gate(){return this.paused?new Promise(r=>this.resume=r):Promise.resolve();},
  async sleep(ms){const end=Date.now()+ms/this.speed;const t=this.token;
    while(Date.now()<end){await this.gate();if(t!==this.token)throw'abort';await new Promise(r=>setTimeout(r,30));}
    if(t!==this.token)throw'abort';},
  toggle(){ if(this.mode==='script'){ this.playing?this.pause():this.play(); }
            else { this.paused?this.unpause():this.pause(); } },
  pause(){this.paused=true;this.playing=false;$('#bPlay').innerHTML='&#9654; Play';
    if(this.audio)this.audio.pause();try{speechSynthesis.pause()}catch(e){}clearInterval(this._ka);},
  unpause(){this.paused=false;$('#bPlay').innerHTML='&#9208; Pause';
    if(this.audio)this.audio.play().catch(()=>{});try{speechSynthesis.resume()}catch(e){}
    if(this.resume){this.resume();this.resume=null}},
  stop(){this.token++;this.paused=false;this.playing=false;if(this.resume){this.resume();this.resume=null}
    if(this.audio){this.audio.pause();this.audio=null}try{speechSynthesis.cancel()}catch(e){}clearInterval(this._ka);},
  // scripted walkthrough
  load(script){this.mode='script';this.script=script;this.idx=0;},
  restart(){this.stop();clearTerm();this.idx=0;if(this.mode==='script')this.play();},
  play(){this.stop();this.paused=false;this.playing=true;$('#bPlay').innerHTML='&#9208; Pause';this.run();},
  async run(){
    const t=(this.token+1); this.token=t;
    try{
      for(;this.idx<this.script.length;this.idx++){
        if(t!==this.token)return;
        const s=this.script[this.idx];
        await this.render(s);
        if(s.voice && this.speed<=2) await this.waitVoice(6000);   // wait for voice only when slowed down
        await this.sleep(s.after||300);
      }
      this.playing=false;$('#bPlay').innerHTML='&#9654; Play';
    }catch(e){/*aborted*/}
  },
  async waitVoice(capMs){
    const t=this.token, end=Date.now()+capMs;
    await new Promise(r=>setTimeout(r,140));      // let it start
    while(Date.now()<end){
      if(t!==this.token) throw 'abort';
      const busy = (this.audio && !this.audio.paused && !this.audio.ended)
                || (('speechSynthesis' in window) && (speechSynthesis.speaking||speechSynthesis.pending));
      if(!busy) break;
      await this.gate(); if(t!==this.token) throw 'abort';
      await new Promise(r=>setTimeout(r,80));
    }
  },
  step(dir){ if(this.mode!=='script')return;
    this.stop();
    this.idx=Math.max(0,Math.min(this.script.length-1,this.idx+dir));
    clearTerm();
    for(let i=0;i<this.idx;i++) this.renderInstant(this.script[i]);
    this.render(this.script[this.idx]); },
  renderInstant(s){ if(s.clear){clearTerm();return;} if(s.text!=null) line(s.text,s.cls); },
  async render(s){
    if(s.clear){clearTerm();}
    if(s.voice) this.speak(s.voice,s.text);
    if(s.text==null)return;
    if(reduce||s.instant){line(s.text,s.cls);return;}
    const el=line('',s.cls); el.classList.add('cursor');
    const txt=s.text; const per=(s.typ||16);
    for(let i=0;i<txt.length;i++){await this.sleep(per);el.textContent=txt.slice(0,i+1);TERM.scrollTop=TERM.scrollHeight;}
    el.classList.remove('cursor');
  },
  speak(key,text){
    if(!SFX.on) return;                     // mute silences narration too
    if(ST.hasVoice){
      const a=new Audio('/voice/'+key+'.mp3'); this.audio=a;
      a.onerror=()=>this.tts(text); a.play().catch(()=>this.tts(text));
    } else this.tts(text);
  },
  tts(text){ if(!text)return; if(!('speechSynthesis' in window))return;
    try{
      speechSynthesis.cancel();
      const u=new SpeechSynthesisUtterance(text.replace(/[>_#]/g,' ').replace(/\s+/g,' ').trim());
      u.rate=Math.min(1.7, 0.9 + (this.speed-1)*0.16); u.pitch=0.6;  // scales with speed, capped for clarity
      const vs=speechSynthesis.getVoices();
      if(vs&&vs.length){
        u.voice = vs.find(v=>/en/i.test(v.lang)&&/(male|david|daniel|fred|rishi|google uk english male)/i.test(v.name))
               || vs.find(v=>/en/i.test(v.lang)) || vs[0];
      }
      // Chrome/Android kills long speech after ~15s unless nudged
      u.onstart=()=>{ clearInterval(this._ka); this._ka=setInterval(()=>{try{speechSynthesis.resume()}catch(e){}},7000); };
      u.onend=u.onerror=()=>{ clearInterval(this._ka); };
      speechSynthesis.speak(u);
    }catch(e){} }
};
// speed control buttons
[1,2,4,6,8].forEach(v=>{const b=document.createElement('button');b.textContent=v+'\u00d7';b.dataset.v=v;b.onclick=()=>P.setSpeed(v);$('#speed').appendChild(b);});
P.setSpeed(2);   // default 2x; slower (1x) and faster (4/6/8x) available

// ---------- stage entry ----------
let caseData=null;
const DIFF_LABEL=['Learn (guided)','Easy','Medium','Hard','Custom'];

async function enterStage(){
  $('#stageTitle').textContent = `Lesson ${lesson} \u00b7 ${DIFF_LABEL[cur]}`;
  clearTerm(); const g=$('#guess'); if(g)g.value=''; const gu=$('#guessUser'); if(gu)gu.value='';
  P.stop(); stageStart=Date.now(); stageTries=0;
  const guided = cur===0;
  $('#playbar').style.display = guided ? 'flex':'none';
  if(gu) gu.style.display = (lesson===2)?'block':'none';   // username field: L2 only
  if(g)  g.placeholder = (lesson===4)?'the target host IP'
                       : (lesson===3)?'the password you found'
                       : (lesson===2)?'password':'type the password';
  $('#guessHint').innerHTML = (lesson===4)
    ? 'Scan the subnet, open hosts, find the weak one, and enter its IP.'
    : (lesson===3)
    ? 'Click a packet to open it. Find the credential in the clear, type it, hit Enter.'
    : (lesson===2)
    ? 'Enter a username + password. A real user errors differently than a fake one.'
    : 'Type a guess and hit Enter. Read the recon &mdash; the password is built from it.';
  const cw=$('#cliWrap');
  if(cw){
    cw.style.display = (lesson===3||lesson===4)?'block':'none';
    const hdr=cw.querySelector('.clihdr'), ci=$('#cli');
    if(lesson===4){ if(ci)ci.placeholder='scan   or   nmap <ip>';
      if(hdr)hdr.innerHTML='// recon CLI \u2014 <b>scan</b> for hosts, <b>nmap &lt;ip&gt;</b> to port-scan'; }
    else if(lesson===3){ if(ci)ci.placeholder='decode <base64 string>';
      if(hdr)hdr.innerHTML='// decoder CLI \u2014 run <b>decode &lt;string&gt;</b> to base64-decode'; }
  }
  setAutoBtn();
  if(cur===4){                                   // custom case (L1 only)
    renderCase(caseData); P.mode='live';
    line('custom case built.','sys');
    line('crack '+(caseData?caseData.name:'the target')+"'s password from their own details.",'info');
    if(!autoUnlocked) line('wordlist attack unlocks after '+AUTO_UNLOCK_AT+' manual tries.','deny');
  } else {
    await newCase(true);
    const script = lesson===4?lesson4Script() : lesson===3?lesson3Script() : lesson===2?lesson2Script() : lesson1Script();
    if(guided){ P.load(script); P.play(); }
    else {
      P.mode='live';
      line('sandbox ready.','sys');
      if(lesson===4){
        line('subnet '+(caseData?caseData.subnet:'?')+' \u2014 '+(caseData?caseData.hosts.length:0)+' live hosts','info');
        line('open a host (tap it, or CLI: nmap <ip>) and find the weak service.','info');
      } else if(lesson===3){
        line('capture loaded: '+(caseData?caseData.packets.length:0)+' packets on '+(caseData?caseData.net:'?'),'info');
        line('click a packet below to read it, then type the password you find.','info');
        if(cur>=3){
          line('this one hides the login in base64 (Authorization: Basic ...).','deny');
          line('copy the text after "Basic " and decode it in the CLI:  decode <string>','deny');
          line('that gives user:password \u2014 then type the password here.','deny');
        }
      } else if(lesson===2){
        line('target: '+(caseData?caseData.panel:'login')+' @ '+(caseData?caseData.url:'?'),'info');
        line('read the recon below, find a working login.','info');
      } else {
        line('read the recon below, then guess '+(caseData?caseData.name:'the target')+"'s password.",'info');
      }
      if(!autoUnlocked) line((lesson>=3?'auto-analyze':'wordlist attack')+' unlocks after '+AUTO_UNLOCK_AT+' manual tries.','deny');
    }
  }
  if(gu && lesson===2) gu.focus(); else if(g) g.focus();
}

async function buildCustomCase(){
  const v=id=>$('#'+id).value.trim();
  const data={name:v('c_name'),pet:v('c_pet'),kid:v('c_kid'),year:v('c_year'),
              team:v('c_team'),city:v('c_city'),diff:$('#c_diff').value};
  try{ caseData=await post('/api/custom',data); }catch(e){ caseData=null; }
  cur=4; go('stage');
}

async function newCase(quiet){
  if(cur===4){ go('custom'); return; }           // custom "New case" -> re-edit the form
  const url = lesson===4?'/api/l4/newcase' : lesson===3?'/api/l3/newcase' : lesson===2?'/api/l2/newcase':'/api/newcase';
  try{ caseData = await post(url,{stage:cur}); }
  catch(e){ caseData=null; }
  renderCase(caseData);
  if(!quiet){ clearTerm(); line('new case loaded','sys'); stageStart=Date.now(); stageTries=0; }
}

function showPacket(i){
  const p=caseData&&caseData.packets?caseData.packets[i]:null; if(!p)return;
  line('','info');
  line('-- packet #'+(i+1)+'  '+p.proto+'  '+p.src+' -> '+p.dst,'sys');
  if(p.info) line('   '+p.info,'deny');
  (p.payload||'').split('\n').forEach(l=>line('   '+l,'info'));
  SFX.blip();
}
function showHost(i){
  const h=caseData&&caseData.hosts?caseData.hosts[i]:null; if(!h)return;
  line('','info');
  line('-- nmap '+h.ip+'   ('+h.name+')','sys');
  (h.ports||'').split('\n').forEach(l=>line('   '+l,'info'));
  SFX.blip();
}

function renderCase(c){
  if(!c){ $('#scenario').innerHTML=''; $('#clues').innerHTML=''; $('#hints').innerHTML=''; return; }
  if(lesson===4){
    $('#scenario').innerHTML =
      `<div class="scen"><span class="lab">SUBNET</span><b>${c.subnet}</b> &middot; ${c.hosts.length} live hosts</div>`;
    $('#clues').innerHTML = '<div class="reconhdr">// live hosts \u2014 tap one to port-scan</div>' +
      c.hosts.map((h,i)=>`<div class="pkt" onclick="showHost(${i})"><span class="pno">${i+1}</span><span class="pproto">${h.ip}</span>${h.name}</div>`).join('');
    $('#hints').innerHTML = c.hint ? `<div class="hint">${c.hint}</div>` : '';
    return;
  }
  if(lesson===3){
    $('#scenario').innerHTML =
      `<div class="scen"><span class="lab">CAPTURE</span><b>${c.packets.length} packets</b> &middot; ${c.net}</div>`;
    $('#clues').innerHTML = '<div class="reconhdr">// packets \u2014 tap one to open</div>' +
      c.packets.map((p,i)=>`<div class="pkt" onclick="showPacket(${i})"><span class="pno">${i+1}</span><span class="pproto">${p.proto}</span>${p.src} &rarr; ${p.dst}</div>`).join('');
    $('#hints').innerHTML = c.hint ? `<div class="hint">${c.hint}</div>` : '';
    return;
  }
  if(lesson===2){
    $('#scenario').innerHTML =
      `<div class="scen"><span class="lab">TARGET</span><b>${c.panel}</b> &middot; ${c.url}</div>`;
    let recon = '<div class="reconhdr">// recon notes</div>' +
      (c.clues||[]).map(x=>`<div class="clue">${x}</div>`).join('');
    if(c.users && c.users.length){
      recon += '<div class="reconhdr">// accounts to try</div>' +
        c.users.map(u=>`<div class="clue">${u}</div>`).join('');
    }
    $('#clues').innerHTML = recon;
  } else {
    $('#scenario').innerHTML =
      `<div class="scen"><span class="lab">TARGET</span><b>${c.name}</b> &middot; ${c.acct}</div>`;
    $('#clues').innerHTML =
      '<div class="reconhdr">// recon notes</div>' + c.clues.map(x=>`<div class="clue">${x}</div>`).join('');
  }
  $('#hints').innerHTML = c.hint ? `<div class="hint">${c.hint}</div>` : '';
}

// ---------- talking to the sandbox ----------
async function post(url,data){
  const body=Object.entries(data).map(([k,v])=>k+'='+encodeURIComponent(v)).join('&');
  const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body});
  return r.json();
}
// ---------- fun: sound, flair, gating ----------
const SFX={ on:true, ctx:null,
  ac(){ if(!this.ctx){ try{this.ctx=new (window.AudioContext||window.webkitAudioContext)();}catch(e){} }
        if(this.ctx&&this.ctx.state==='suspended'){ this.ctx.resume().catch(()=>{}); } return this.ctx; },
  tone(f,dur,type,vol){ if(!this.on)return; const c=this.ac(); if(!c)return;
    const o=c.createOscillator(),g=c.createGain(); o.type=type||'square'; o.frequency.value=f;
    const t=c.currentTime; g.gain.setValueAtTime(vol||0.05,t); o.connect(g); g.connect(c.destination);
    o.start(t); g.gain.exponentialRampToValueAtTime(0.0001,t+(dur||0.08)); o.stop(t+(dur||0.08)+0.02); },
  blip(){ this.tone(660,0.05,'square',0.04); },
  deny(){ this.tone(150,0.2,'sawtooth',0.06); setTimeout(()=>this.tone(110,0.2,'sawtooth',0.05),90); },
  tick(){ this.tone(380,0.02,'square',0.02); },
  win(){ [523,659,784,1047].forEach((f,i)=>setTimeout(()=>this.tone(f,0.15,'triangle',0.06),i*110)); },
};
function toggleSound(){
  SFX.on=!SFX.on;
  $('#mute').innerHTML=SFX.on?'&#128266;':'&#128263;';
  if(SFX.on){ SFX.blip(); }
  else { try{speechSynthesis.cancel();}catch(e){} if(P.audio){try{P.audio.pause();}catch(e){}} }  // kill voice now
}
const DENIES=['access denied','nope','denied','not even close','the lock laughs','try harder, human',
  'nice try','rejected','the mainframe is unimpressed','wrong. again.','denied. keep going.'];
function shake(el){ if(!el)return; el.classList.remove('shake'); void el.offsetWidth; el.classList.add('shake'); }
function flashOk(){ TERM.classList.remove('flashok'); void TERM.offsetWidth; TERM.classList.add('flashok'); }

let manualCount=0, autoUnlocked=false, stageStart=0, stageTries=0;
const AUTO_UNLOCK_AT=10;
function setAutoBtn(){
  const b=$('#bAuto'); if(!b)return;
  if(autoUnlocked){ b.disabled=false; b.innerHTML='&#9889; '+(lesson>=3?'Auto-analyze':'Run wordlist attack'); }
  else { b.disabled=true; b.innerHTML='&#128274; Auto locked &middot; '+Math.min(manualCount,AUTO_UNLOCK_AT)+'/'+AUTO_UNLOCK_AT; }
}
function bumpManual(){
  manualCount++;
  if(!autoUnlocked && manualCount>=AUTO_UNLOCK_AT){
    autoUnlocked=true; line('','info');
    line('>> auto-attack UNLOCKED \u2014 you put in the reps. easy button earned.','ok'); SFX.win();
  }
  setAutoBtn();
}
// physical keyboard: Enter submits the password field
document.addEventListener('keydown',e=>{
  if(!$('#stage').classList.contains('on')) return;
  if(e.key==='Enter' && (document.activeElement===$('#guess')||document.activeElement===$('#guessUser'))){ e.preventDefault(); submitGuess(); }
  if(e.key==='Enter' && document.activeElement===$('#cli')){ e.preventDefault(); handleCli(); }
});

// tiny in-portal CLI: base64 decode helper for Lesson 3
function handleCli(){
  const el=$('#cli'); if(!el) return;
  const cmd=el.value.trim(); if(!cmd) return;
  el.value=''; line('$ '+cmd,'cmd'); SFX.blip();
  const parts=cmd.split(/\s+/); const c=parts[0].toLowerCase();
  if(lesson===4){                                  // nmap-style recon CLI
    if(c==='help'){ line('  scan          discover live hosts','info'); line('  nmap <ip>     port-scan a host','info'); return; }
    if(c==='scan' || (c==='nmap' && parts.length<2)){
      line('  host discovery on '+(caseData?caseData.subnet:'net')+' ...','sys');
      (caseData&&caseData.hosts?caseData.hosts:[]).forEach(h=>line('   '+h.ip+'   '+h.name,'info'));
      return;
    }
    if(c==='nmap'){
      const hs=caseData&&caseData.hosts?caseData.hosts:[];
      const idx=hs.findIndex(h=>h.ip===parts[1]);
      if(idx<0){ line('   host down / not found','deny'); return; }
      showHost(idx); return;
    }
    line('  unknown \u2014 try:  scan  |  nmap <ip>','deny'); return;
  }
  // Lesson 3 decoder CLI
  if(c==='help'){
    line('  decode <string>   base64-decode a value','info');
    line('  (copy the text after "Basic " in a packet, then decode it)','deny');
    return;
  }
  if(c==='decode'||c==='base64'||c==='b64'||c==='atob'){
    const arg=parts[parts.length-1];
    if(!arg||arg===c){ line('  usage: decode <base64 string>','deny'); return; }
    try{ line('  '+atob(arg),'ok'); }
    catch(e){ line('  not valid base64','bad'); }
    return;
  }
  line('  unknown command \u2014 try:  decode <base64>   (or: help)','deny');
}

async function submitGuess(){
  if(lesson===2) return submitLogin();
  const g=$('#guess'); if(!g) return;
  const guess=g.value.trim(); if(!guess) return;
  g.value=''; line('> '+(lesson>=3?'submit: ':'try ')+guess,'cmd'); stageTries++;
  try{
    const r = lesson===4 ? await post('/api/l4/check',{stage:cur,answer:guess})
            : lesson===3 ? await post('/api/l3/check',{stage:cur,answer:guess})
                         : await post('/api/attempt',{stage:cur,guess});
    if(r.correct){ onSolved(guess); return; }
    line('  '+(lesson===4?'not the target \u2014 keep scanning'
              :lesson===3?'not the credential \u2014 keep reading packets'
                         :DENIES[Math.floor(Math.random()*DENIES.length)]),'bad');
    SFX.deny(); shake($('#guess')); bumpManual();
  }catch(e){ line('  (no response from target)','bad'); }
  g.focus();
}

async function submitLogin(){
  const gu=$('#guessUser'), g=$('#guess');
  const user=(gu?gu.value.trim():''), pass=(g?g.value.trim():'');
  if(!user||!pass){ line('  enter a username AND a password','deny'); return; }
  g.value=''; line('> '+user+' : '+pass,'cmd'); stageTries++;
  try{
    const r=await post('/api/l2/login',{stage:cur,user,pass});
    if(r.locked){ line('  [LOCKED OUT] too many tries \u2014 wait '+r.wait+'s','bad'); SFX.deny(); shake($('#guess')); return; }
    if(r.correct){ onSolved(user+' / '+pass); return; }
    if(r.userValid) line('  valid user, wrong password','bad');
    else            line('  unknown user \u2014 that account does not exist','deny');
    SFX.deny(); shake($('#guess')); bumpManual();
  }catch(e){ line('  (no response from target)','bad'); }
  g.focus();
}

let running=false;
async function autoAttack(){
  if(running)return;
  if(!autoUnlocked){ line('wordlist attack locked \u2014 '+(AUTO_UNLOCK_AT-manualCount)+' more manual tries to go.','deny'); SFX.deny(); return; }
  stopAll(); running=true;
  setStatus('attack'); P.mode='live'; P.paused=false; P.token++;
  const t=P.token; $('#bAuto').disabled=true;
  const url = lesson===4?'/api/l4/sweep' : lesson===3?'/api/l3/sweep' : lesson===2?'/api/l2/sweep':'/api/sweep';
  line('','info');
  line(lesson===4?'# auto-scanning the subnet...'
      :lesson===3?'# auto-analyzing the capture...'
      :lesson===2?'# spraying a credential wordlist...'
      :'# building wordlist from recon, mangling & trying...','sys');
  let res;
  try{ res=await post(url,{stage:cur}); }
  catch(e){ line('  (target unreachable)','bad'); running=false; setAutoBtn(); return; }
  try{
    if(lesson>=3){                           // walk through the analysis steps, then reveal
      for(const step of res.steps){
        if(t!==P.token) throw 'abort';
        line('  '+step,'deny'); SFX.tick(); await P.sleep(500);
      }
      line('  found: '+res.flag,'ok');
      onSolved(res.flag);
    } else {
      stageTries += res.tries;
      const hitVal = lesson===2?res.cred:res.password;
      for(const cand of res.tried){
        if(t!==P.token) throw 'abort';
        const hit=(cand===hitVal);
        line('  '+cand+(hit?'  ... MATCH':'  ... nope'), hit?'ok':'deny');
        SFX.tick(); await P.sleep(300);
        if(hit) break;
      }
      onSolved(hitVal);
    }
  }catch(e){ line('  [stopped]','deny'); }
  running=false; setAutoBtn();
}

function onSolved(what){
  setStatus('solved');
  const secs=((Date.now()-stageStart)/1000).toFixed(1);
  line('','info');
  line(lesson===4 ? 'WAY IN FOUND  \u2014  target host  '+what
      :lesson===3 ? 'CAPTURED  \u2014  credential in the clear:  '+what
      :lesson===2 ? 'ACCESS GRANTED  \u2014  logged in as  '+what
                  : 'ACCESS GRANTED  \u2014  password was  '+what, 'ok');
  line(lesson>=3 ? '  found in '+stageTries+' looks / '+secs+'s'
                 : '  cracked in '+stageTries+' tries / '+secs+'s','info');
  SFX.win(); flashOk();
  P.stop();
  if(cur===4){                                   // custom demo: no progression
    line('','info');
    line("that's how fast a 'personal' password falls. long + random is the fix.",'sys');
    setTimeout(()=>setStatus('idle'), 400);
    return;
  }
  solvedArr(lesson)[cur]=true;                    // server already recorded it
  if(cur>=3){ setTimeout(showWin,1100); }
  else {
    line('','info');
    line('stage '+(cur+1)+' cleared. stage '+(cur+2)+' unlocked.','sys');
    setTimeout(()=>go('menu'),1600);
  }
}

function showWin(){
  $('#grant').textContent =
`  ######  ######
  #    #  #
  #    #  #  ###
  ######  ######
     C Y B E R C H U C K
        g g   :)`;
  $('#winMsg').textContent = lesson===4
    ? 'Lesson 4 complete. You mapped the network and found the way in every time.'
    : lesson===3
    ? 'Lesson 3 complete. You pulled credentials straight out of the traffic â€” even the base64 one.'
    : lesson===2
    ? 'Lesson 2 complete. You beat the login â€” defaults, enumeration, and a locked-down target.'
    : 'Lesson 1 complete. You cracked every difficulty â€” even Hard with no pattern hint.';
  setStatus('idle'); go('win');
}

function stopAll(){ running=false; P.stop(); setStatus('idle'); }

// ---------- status light (mirrors the dongle screen/LED) ----------
function setStatus(s){
  const d=$('#dot'); d.className='dot'+(s==='idle'?'':' '+s);
  $('#statTxt').textContent=s;
  post('/api/status',{state:s}).catch(()=>{});
}

// ---------- boot ----------
async function init(){
  try{ const s=await (await fetch('/api/state')).json(); Object.assign(ST,s);}catch(e){}
  // warm up TTS voice list on some browsers
  try{ speechSynthesis.getVoices(); speechSynthesis.onvoiceschanged=()=>{}; }catch(e){}
}
init();

// ================= Lesson 1 walkthrough script =================
function lesson1Script(){
  return [
   {text:'>_ initializing lesson_01 :: password recon & guessing',cls:'sys',after:700,voice:'l1_00'},
   {text:'',after:200},
   {text:'Most people do not use random passwords. They use their life.',cls:'info',voice:'l1_01',after:1000},
   {text:'A pet\'s name. A kid. A birth year. A team they love.',cls:'info',voice:'l1_02',after:1000},
   {text:'',after:250},
   {text:'Step one is recon: quietly gather those personal facts.',cls:'info',voice:'l1_03',after:1000},
   {text:'Step two: mash the facts into likely passwords and try them fast.',cls:'info',voice:'l1_04',after:1100},
   {text:'',after:300},
   {text:'Say recon on "Sarah Kline" turns up a cat named Bella, born 2016.',cls:'sys',voice:'l1_05',after:1000},
   {text:'A cracker\'s first guesses write themselves:',cls:'info',voice:'l1_06',after:700},
   {text:'  bella ... nope',cls:'deny',after:260},
   {text:'  Bella2016 ... nope',cls:'deny',after:260},
   {text:'  bella16 ... nope',cls:'deny',after:260},
   {text:'  B3lla2016! ... nope',cls:'deny',after:260},
   {text:'  Bella2016 ... MATCH',cls:'ok',after:900,voice:'l1_07'},
   {text:'',after:300},
   {text:'One of those usually lands. Human passwords are predictable.',cls:'info',voice:'l1_08',after:1100},
   {text:'',after:300},
   {text:'Your live target is shown below with real recon notes.',cls:'sys',voice:'l1_09',after:900},
   {text:'Read the clues and figure out how they built the password.',cls:'info',voice:'l1_10',after:1000},
   {text:'Type a guess, or after 10 tries run the wordlist attack.',cls:'cmd',voice:'l1_11',after:900},
   {text:'Harder difficulties add mashups and l33t swaps. Pick them from the menu.',cls:'deny',voice:'l1_12',after:400},
  ];
}

// ================= Lesson 2 walkthrough script =================
function lesson2Script(){
  return [
   {text:'>_ initializing lesson_02 :: login brute force',cls:'sys',after:700,voice:'l2_00'},
   {text:'',after:200},
   {text:'A login wants two things now: a username AND a password.',cls:'info',voice:'l2_01',after:1000},
   {text:'That sounds harder. Usually it is not.',cls:'info',voice:'l2_02',after:900},
   {text:'',after:250},
   {text:'Step one, always: try the factory defaults.',cls:'sys',voice:'l2_03',after:900},
   {text:'  admin : admin ... nope',cls:'deny',after:260},
   {text:'  admin : password ... MATCH',cls:'ok',after:900,voice:'l2_04'},
   {text:'Half the routers and cameras online never changed these.',cls:'info',voice:'l2_05',after:1100},
   {text:'',after:300},
   {text:'No default? Then find a REAL username first.',cls:'sys',voice:'l2_06',after:900},
   {text:'A login often leaks it: "unknown user" vs "wrong password".',cls:'info',voice:'l2_07',after:1100},
   {text:'That difference IS the answer â€” it tells you which account exists.',cls:'cmd',voice:'l2_08',after:1100},
   {text:'',after:300},
   {text:'Once you know the user, crack its password like lesson 1.',cls:'info',voice:'l2_09',after:1000},
   {text:'On locked-down targets, too many misses = a lockout.',cls:'info',voice:'l2_10',after:1000},
   {text:'That is why pros go slow, or spray one password across many users.',cls:'info',voice:'l2_11',after:1100},
   {text:'Your live target is below. Find a login that works.',cls:'cmd',voice:'l2_12',after:500},
  ];
}

// ================= Lesson 3 walkthrough script =================
function lesson3Script(){
  return [
   {text:'>_ initializing lesson_03 :: traffic sniffing',cls:'sys',after:700,voice:'l3_00'},
   {text:'',after:200},
   {text:'Everything on a network travels as packets.',cls:'info',voice:'l3_01',after:900},
   {text:'On open Wi-Fi, anyone nearby can capture them.',cls:'info',voice:'l3_02',after:1000},
   {text:'Encrypted traffic (HTTPS, TLS) just looks like noise.',cls:'info',voice:'l3_03',after:1000},
   {text:'But plaintext protocols hand you everything.',cls:'cmd',voice:'l3_04',after:1000},
   {text:'',after:250},
   {text:'A plain HTTP login POSTs your password as readable text:',cls:'sys',voice:'l3_05',after:900},
   {text:'  POST /login',cls:'deny',after:220},
   {text:'  username=sarah&password=Bella2016',cls:'ok',after:1100,voice:'l3_06'},
   {text:'No cracking needed. It is right there in the capture.',cls:'info',voice:'l3_07',after:1100},
   {text:'',after:250},
   {text:'Your job: open packets, skip the encrypted noise,',cls:'info',voice:'l3_08',after:900},
   {text:'and find the one that leaks a credential.',cls:'info',voice:'l3_09',after:900},
   {text:'Tap a packet below to read it.',cls:'cmd',voice:'l3_10',after:900},
   {text:'Harder captures hide it in base64 - paste it into the CLI: decode <string>.',cls:'info',voice:'l3_11',after:1000},
   {text:'Type the password you find, or auto-analyze after 10 looks.',cls:'cmd',voice:'l3_12',after:500},
  ];
}

// ================= Lesson 4 walkthrough script =================
function lesson4Script(){
  return [
   {text:'>_ initializing lesson_04 :: network enumeration',cls:'sys',after:700,voice:'l4_00'},
   {text:'',after:200},
   {text:'You are on the network. Now you map it.',cls:'info',voice:'l4_01',after:900},
   {text:'Enumeration = which hosts are alive, and what they run.',cls:'info',voice:'l4_02',after:1000},
   {text:'A port scan lists open ports; each port is a service, a door.',cls:'info',voice:'l4_03',after:1100},
   {text:'',after:250},
   {text:'Most doors are fine. You hunt for the weak one:',cls:'sys',voice:'l4_04',after:900},
   {text:'  telnet or ftp - logins in plaintext',cls:'deny',after:260},
   {text:'  a database or share with no password',cls:'deny',after:260},
   {text:'  old, unpatched services like SMBv1',cls:'deny',after:260},
   {text:'',after:250},
   {text:'Workflow: discover hosts, then scan each one.',cls:'info',voice:'l4_05',after:1000},
   {text:'  scan            finds live hosts',cls:'cmd',after:260},
   {text:'  nmap 192.168.1.5  port-scans that host',cls:'cmd',after:900,voice:'l4_06'},
   {text:'(or just tap a host in the list to scan it.)',cls:'deny',voice:'l4_07',after:1000},
   {text:'',after:250},
   {text:'Read the services. Spot the one that should not be there.',cls:'info',voice:'l4_08',after:1000},
   {text:'That host is your way in.',cls:'info',voice:'l4_09',after:900},
   {text:'Your live subnet is below. Find the weak host,',cls:'sys',voice:'l4_10',after:900},
   {text:'and enter its IP address.',cls:'cmd',voice:'l4_11',after:900},
   {text:'Stuck after 10 looks? Auto-analyze names it for you.',cls:'deny',voice:'l4_12',after:500},
  ];
}
</script>
