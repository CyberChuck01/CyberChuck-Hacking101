String leet(const String &w){
  String o; for (char c : w){ char l=tolower(c);
    if(l=='a')o+='4'; else if(l=='e')o+='3'; else if(l=='i')o+='1';
    else if(l=='o')o+='0'; else if(l=='s')o+='5'; else o+=c; } return o;
}
